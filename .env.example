# Local PostgreSQL configuration for the AgenticShop development database.
# Copy this file to .env before starting Docker Compose.
POSTGRES_DB=agenticshop
POSTGRES_USER=agenticshop_app
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# This will be consumed by the FastAPI application once database access is added.
DATABASE_URL=postgresql://agenticshop_app:change-me-for-local-development@localhost:5432/agenticshop
